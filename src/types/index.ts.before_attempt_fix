// TypeScript Definitions for Tensor MacTober Touch Type Championship

export type EventStatus = 'NOT_STARTED' | 'LIVE' | 'ENDED';

export interface ChampionshipEvent {
  id: string;
  name: string;
  subtitle?: string | null;
  organization_name?: string | null;
  status: EventStatus;
  start_time: string | null;
  end_time: string | null;
  test_duration: number; // in seconds (e.g. 60)
  event_duration: number; // in minutes (e.g. 60)
  minimum_accuracy: number; // e.g. 85.0
  max_attempts: number | null; // null for unlimited
  finalists_count: number; // default 2
  passage: string;
  is_demo: boolean;
  created_at: string;
  updated_at: string;
}

export interface Participant {
  id: string;
  event_id: string;
  name: string;
  student_id: string;
  email?: string | null;
  session_id: string;
  disqualified: boolean;
  disqualification_reason?: string | null;
  attempts_count?: number;
  created_at: string;
}

export interface 
TypingAttempt {
  id: string;
  event_id: string;
  participant_id: string;
  started_at: string;
  completed_at: string;
  tab_switches: number;
  elapsed_seconds: number;
  wpm: number; // precise float
  wpm_display: number; // rounded integer
  accuracy: number; // percentage rounded to 2 decimal places
  correct_characters: number;
  incorrect_characters: number;
  total_characters: number;
  qualified: boolean;
  is_demo: boolean;
  created_at: string;
}

export interface LeaderboardEntry {
  rank: number;
  participant_id: string;
  name: string;
  student_id: string;
  best_wpm: number;
  best_wpm_precise: number;
  best_accuracy: number;
  attempts_count: number;
  last_attempt_at: string;
  disqualified?: boolean;
}

export interface AdminStats {
  event: ChampionshipEvent;
  totalParticipants: number;
  totalAttempts: number;
  qualifiedParticipants: number;
  topParticipants: LeaderboardEntry[];
  finalists: LeaderboardEntry[];
  currentServerTime: string;
}

export interface SubmissionPayload {
  eventId: string;
  participantId: string;
  sessionId: string;
  startedAt: string;
  completedAt: string;
  elapsedSeconds: number;
  passageText: string;
  typedText: string;
  correctCharacters: number;
  incorrectCharacters: number;
  totalCharacters: number;
}
