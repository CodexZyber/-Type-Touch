# PostgreSQL (docker compose `db` service)
# Generate a password with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
# Used by `npm run dev` on the host; docker compose overrides the host to `db`.
# Leave unset to run on the in-memory fallback store.
DATABASE_URL=postgres://tensor:change-me@localhost:5432/tensor

# Admin Authentication (Generated via: npm run admin:setup)
# DO NOT hardcode plain passwords here or in source code!
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
