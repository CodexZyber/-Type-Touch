# /etc/systemd/system/tensor-mactober.service
# Next.js standalone server for the typing championship. Listens on 127.0.0.1:3100;
# nginx is the only public door. Config lives in /opt/tensor-mactober/app.env.
[Unit]
Description=Tensor MacTober Typing Championship (Next.js)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=tensormactober
Group=tensormactober
WorkingDirectory=/opt/tensor-mactober/app
EnvironmentFile=/opt/tensor-mactober/app.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3

# Shared machine: cap the app and keep it ahead of student jobs for the OOM killer.
MemoryMax=512M
OOMScoreAdjust=-500

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/tensor-mactober/app/.next
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes

[Install]
WantedBy=multi-user.target
